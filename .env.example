# Copy this file to .env and change it as desired.
# A .env file is not necessary if all values are exported in the shell.

# Refresh API
REFRESH_API_KEY=choose-a-secret-refresh-key
REFRESH_API_HOST=0.0.0.0
REFRESH_API_PORT=8060

# Bokeh dashboard
BOKEH_HOST=0.0.0.0
BOKEH_PORT=8059
BOKEH_ALLOW_WEBSOCKET_ORIGIN=*
BOKEH_BASE_URL=/

# Optional fixed grid fallback. Explicit data.json bounds [[0, width], [0, height]]
# override this value when present.
GRID_SIZE=
GRID_WIDTH=
GRID_HEIGHT=

# Local data source (used only when LOCAL_FILES_FIRST_FOR_TESTING=1)
LOCAL_DATA_DIR=
# Set to 1 for local-first dev/testing; default is S3 / remote JSON
LOCAL_FILES_FIRST_FOR_TESTING=

# S3 data source
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_DATA_KEY=
S3_SURROGATE_KEY=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
