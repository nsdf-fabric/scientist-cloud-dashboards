# Copy this file to .env and change it as desired.
# A .env file is not necessary if all values are exported in the shell.

# Refresh API
REFRESH_API_KEY=choose-a-secret-refresh-key
REFRESH_API_HOST=0.0.0.0
REFRESH_API_PORT=8060

# Optional private stream/demo script interval. The dashboard itself refreshes by API trigger.
REFRESH_SECONDS=10

# Bokeh dashboard
BOKEH_HOST=0.0.0.0
BOKEH_PORT=8059
BOKEH_ALLOW_WEBSOCKET_ORIGIN=*

# Optional fixed grid fallback. Explicit data.json bounds [[0, width], [0, height]]
# override this value when present.
GRID_SIZE=
GRID_WIDTH=
GRID_HEIGHT=

# Local data source
LOCAL_DATA_DIR=

# S3 data source
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_DATA_KEY=
S3_SURROGATE_KEY=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
