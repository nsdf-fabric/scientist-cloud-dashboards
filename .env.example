# Copy this file to .env and change it as desired.
# A .env file is not necessary if all values are exported in the shell.

# Refresh API
ORNL_REFRESH_API_KEY=choose-a-secret-refresh-key
ORNL_REFRESH_API_HOST=0.0.0.0
ORNL_REFRESH_API_PORT=8060

# Bokeh dashboard
ORNL_BOKEH_HOST=0.0.0.0
ORNL_BOKEH_PORT=8059
ORNL_BOKEH_ALLOW_WEBSOCKET_ORIGIN=*

# Optional fixed grid fallback. Explicit data.json bounds [[0, width], [0, height]]
# override this value when present.
ORNL_NSDF_GRID_SIZE=
ORNL_NSDF_GRID_WIDTH=
ORNL_NSDF_GRID_HEIGHT=

# Local or HTTP data sources
ORNL_NSDF_DATA_JSON_PATH=
ORNL_NSDF_DATA_JSON_URL=
ORNL_SURROGATE_JSON_PATH=
ORNL_SURROGATE_JSON_URL=

# S3 data source
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ORNL_NSDF_S3_BUCKET=
ORNL_NSDF_S3_DATA_KEY=
ORNL_NSDF_S3_SURROGATE_KEY=
ORNL_NSDF_S3_ENDPOINT_URL=
ORNL_NSDF_S3_REGION=us-east-1
